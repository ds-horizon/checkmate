DB_URL="mysql://root:root_password@localhost:3306/checkmate"
DOCKER_DB_URL="mysql://root:root_password@checkmate-db:3306/checkmate"

# DUMMY GOOGLE CLIENT ID AND SECRET
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
PORT=3000
DOCKER_NODE_ENV="production"

# FOR DOCKER DB SETUP
MYSQL_ROOT_PASSWORD="root_password"
MYSQL_DATABASE="checkmate"
MYSQL_USER="user"
MYSQL_PASSWORD="user_password"

# S3 bucket for test-result screenshot attachments (DFR-1378). Credentials
# come from the environment (EKS Pod Identity in-cluster); no keys needed here.
S3_BUCKET=""
S3_REGION="us-west-2"

# Plane defect delivery is fail-closed and disabled unless all flags are true.
RESULT_REVISION_COMMANDS_ENABLED="false"
PLANE_DEFECT_CREATION_ENABLED="false"
# Copies approved result notes and image attachments to linked Plane work items.
PLANE_EVIDENCE_COPY_ENABLED="false"
PLANE_DELIVERY_WORKER_ENABLED="false"
PLANE_API_WRITES_ENABLED="false"
PLANE_DESTINATION="biz-development"
# API calls default to the public origin for local development. In-cluster
# delivery may use only http://plane-app-api.plane.svc.cluster.local:8000.
PLANE_API_BASE_URL="https://plane-dev.geep-fence.ts.net"
PLANE_API_KEY=""
# `yarn plane:retry-defect-create` is a one-shot operator action. Supply both
# PLANE_DEFECT_RETRY_OUTBOX_ID and PLANE_DEFECT_RETRY_CORRELATION_KEY only to
# the ephemeral Job; do not persist them in a shared environment file.
PLANE_API_TIMEOUT_MS="10000"
# Strict per-worker Plane API start limit. Default 6 assumes exactly two
# singleton workers sharing this key, for a combined maximum of 12 starts/minute.
# Valid values are 1 through 60.
PLANE_MAX_REQUESTS_PER_MINUTE="6"
# Bound each delivery pass to a one-item canary by default. Valid values are 1 through 10.
PLANE_DELIVERY_BATCH_SIZE="1"
# Covers six Plane API calls, each with a worst-case 60s rate-limit wait plus timeout.
PLANE_DELIVERY_LEASE_MS="430000"
PLANE_DELIVERY_POLL_INTERVAL_MS="300000"

# Inbound Plane readiness is independently fail-closed. This must be the exact
# Plane Done-state UUID for the configured destination, never a state name.
PLANE_RETEST_READINESS_ENABLED="false"
PLANE_RETEST_READINESS_WORKER_ENABLED="false"
PLANE_RETEST_NOTIFICATION_ENABLED="false"
PLANE_RETEST_READINESS_DONE_STATE_ID=""
PLANE_RETEST_REOPEN_STATE_ID=""
# Bound each readiness pass to a one-item canary by default. Valid values are 1 through 10.
PLANE_RETEST_READINESS_BATCH_SIZE="1"
PLANE_RETEST_READINESS_POLL_INTERVAL_MS="300000"
# Covers ten serial Plane reads, each with a worst-case 60s rate-limit wait plus timeout.
PLANE_RETEST_READINESS_LEASE_MS="710000"
